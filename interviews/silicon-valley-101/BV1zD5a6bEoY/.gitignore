# Source media and complete transcript remain local.
/audio.*
/video.*
/work.mp4
/sources/transcript.raw.*
/frame-candidates/
/sources/transcript.raw.*
/sources/transcript-reading.md
/sources/metr-study.txt

# Requests contain complete source text; preserve locally for reproducibility.
/generation/*-input.txt
/generation/*-prompt.txt
/generation/*-events.sse
/generation/*-raw.txt
/generation/*-receipt.json

# Keep intermediate model drafts beside their private request evidence.
/generation/chapter-*.json
/generation/plan.json
/generation/book-draft.json
/generation/editorial-*.json
!/generation/editorial-applied.json

# Generated LaTeX outputs are distributed through the release.
/*-notes.pdf
